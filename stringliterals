import React from "react";

function StringLiterals() {
    const name = "premaja";
    const age = 20;
    const message = "hello world";

    const introduction = `${name} and I am ${age} years old`;

    return (
        <div>
            <p>Text using string literals</p>
            <p>{message}</p>
            <p>{introduction}</p>
        </div>
    );
}

export default StringLiterals;
